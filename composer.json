{
    "name": "dmarsal90/laravel-whistleblower",
    "description": "Internal whistleblowing channel for Laravel, built for Spain's Ley 2/2023: anonymous reports, tracking codes, legal deadlines and data retention.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "whistleblowing", "whistleblower", "canal-de-denuncias", "ley-2-2023", "compliance", "gdpr", "spain"],
    "homepage": "https://github.com/dmarsal90/laravel-whistleblower",
    "authors": [
        {
            "name": "David Marsal Ivars",
            "email": "davidmarsalivars@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/dmarsal90/laravel-whistleblower/issues",
        "source": "https://github.com/dmarsal90/laravel-whistleblower"
    },
    "require": {
        "php": "^8.2",
        "illuminate/console": "^11.0 || ^12.0 || ^13.0",
        "illuminate/database": "^11.0 || ^12.0 || ^13.0",
        "illuminate/http": "^11.0 || ^12.0 || ^13.0",
        "illuminate/notifications": "^11.0 || ^12.0 || ^13.0",
        "illuminate/routing": "^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0",
        "illuminate/validation": "^11.0 || ^12.0 || ^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
        "pestphp/pest": "^3.8",
        "pestphp/pest-plugin-laravel": "^3.0",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "Whistleblower\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Whistleblower\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "pint --test",
        "format": "pint",
        "analyse": "phpstan analyse --memory-limit=512M"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": ["Whistleblower\\WhistleblowerServiceProvider"]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
